{
  "contract": "HealthCore Telemetry Event Catalog",
  "format": "custom-event-schema-catalog-v1",
  "schemaVersion": "1.0.0",
  "envelope": {
    "required": [
      "eventId",
      "timestamp",
      "sessionId",
      "userId",
      "event_type",
      "schemaVersion",
      "requestId",
      "properties"
    ],
    "additionalProperties": false,
    "fields": {
      "eventId": {
        "type": "string",
        "format": "uuid",
        "required": true,
        "description": "ID de evento confiable e idempotente."
      },
      "timestamp": {
        "type": "string",
        "format": "date-time",
        "required": true,
        "description": "ISO 8601 UTC."
      },
      "sessionId": {
        "type": ["string", "null"],
        "required": true,
        "description": "ID aleatorio seudónimo; null para jobs."
      },
      "userId": {
        "type": ["string", "null"],
        "required": true,
        "description": "Seudónimo HMAC derivado por servidor; null si anónimo."
      },
      "event_type": {
        "type": "string",
        "pattern": "^[a-z]+_[a-z_]+$",
        "required": true,
        "description": "Nombre estable entidad_acción."
      },
      "schemaVersion": {
        "type": "string",
        "const": "1.0.0",
        "required": true
      },
      "requestId": {
        "type": ["string", "null"],
        "required": true,
        "description": "ID confiable de correlación de request o job."
      },
      "properties": {
        "type": "object",
        "required": true,
        "additionalProperties": false,
        "description": "Debe cumplir el allowlist del event_type."
      }
    }
  },
  "propertyDescriptor": {
    "requiredFields": ["type", "required", "description", "sensitive"],
    "sensitive": "Indica PII, dato operacional restringido o dimensión sensible."
  },
  "events": [
    {
      "event_type": "inventory_inbound_order_created",
      "classification": "mandatory_briefing",
      "source": "RFI de inventario",
      "category": "business_inventory",
      "description": "Entrada de inventario confirmada después del commit.",
      "hypothesisDecision": "Necesitamos entradas diarias por producto y sede para decidir reposición y planificación de recepción.",
      "delivery": {"mode": "stream", "cadence": "Tras commit; agregado diario"},
      "privacy": {"containsSensitiveData": true, "handling": "IDs operativos limitados a acceso RBAC; userId seudónimo; no nombre de proveedor."},
      "allowlist": ["order_id", "supply_id", "quantity", "clinic_id", "country"],
      "properties": {
        "order_id": {"type": "integer", "required": true, "description": "ID de entrada de API.", "sensitive": true},
        "supply_id": {"type": "integer", "required": true, "description": "ID de catálogo; nunca SKU/nombre.", "sensitive": true},
        "quantity": {"type": "integer", "required": true, "description": "Unidades confirmadas.", "sensitive": true},
        "clinic_id": {"type": "integer", "required": true, "description": "ID de clínica 1–12.", "sensitive": true},
        "country": {"type": "string", "enum": ["US", "UK"], "required": true, "description": "País del producto.", "sensitive": false}
      }
    },
    {
      "event_type": "inventory_outbound_order_created",
      "classification": "mandatory_briefing",
      "source": "RFI de inventario",
      "category": "business_inventory",
      "description": "Salida confirmada después del commit.",
      "hypothesisDecision": "Necesitamos salidas diarias para decidir planificación de stock y consumo por sede.",
      "delivery": {"mode": "stream", "cadence": "Tras commit; agregado diario"},
      "privacy": {"containsSensitiveData": true, "handling": "IDs operativos con acceso RBAC; userId seudónimo."},
      "allowlist": ["order_id", "supply_id", "quantity", "clinic_id", "consumption_type", "country"],
      "properties": {
        "order_id": {"type": "integer", "required": true, "description": "ID de salida de API.", "sensitive": true},
        "supply_id": {"type": "integer", "required": true, "description": "ID de catálogo.", "sensitive": true},
        "quantity": {"type": "integer", "required": true, "description": "Unidades confirmadas.", "sensitive": true},
        "clinic_id": {"type": "integer", "required": true, "description": "ID de clínica 1–12.", "sensitive": true},
        "consumption_type": {"type": "string", "enum": ["clinical_use", "expiry_waste"], "required": true, "description": "Tipo controlado de consumo.", "sensitive": true},
        "country": {"type": "string", "enum": ["US", "UK"], "required": true, "description": "País del producto.", "sensitive": false}
      }
    },
    {
      "event_type": "inventory_order_validation_failed",
      "classification": "mandatory_briefing",
      "source": "RFI de inventario",
      "category": "business_inventory",
      "description": "Validación 422 de entrada o salida rechazada.",
      "hypothesisDecision": "Necesitamos los códigos y campos que fallan para decidir correcciones de formularios o datos maestros.",
      "delivery": {"mode": "stream", "cadence": "Muestreo/agrupación de 5 s; agregado diario"},
      "privacy": {"containsSensitiveData": true, "handling": "Solo nombres/códigos allowlisted; nunca valores, cuerpo ni mensaje bruto."},
      "allowlist": ["operation", "field_names", "error_codes", "occurrence_count"],
      "properties": {
        "operation": {"type": "string", "enum": ["inbound", "outbound"], "required": true, "description": "Flujo de orden.", "sensitive": false},
        "field_names": {"type": "array", "items": {"type": "string", "enum": ["supply_id", "quantity", "clinic_id", "vendor_name", "consumption_type"]}, "required": true, "description": "Campos allowlisted con error, sin valores.", "sensitive": false},
        "error_codes": {"type": "array", "items": {"type": "string", "enum": ["missing", "invalid_type", "out_of_range", "invalid_choice", "extra_forbidden"]}, "required": true, "description": "Taxonomía controlada.", "sensitive": false},
        "occurrence_count": {"type": "integer", "minimum": 1, "required": true, "description": "Cantidad agrupada en ventana.", "sensitive": false}
      }
    },
    {
      "event_type": "inventory_direct_stock_edit_rejected",
      "classification": "mandatory_briefing",
      "source": "RFI de inventario / regla de negocio",
      "category": "security_inventory",
      "description": "El gateway rechazó un intento de modificar stock fuera de órdenes.",
      "hypothesisDecision": "Necesitamos detectar intentos de eludir las órdenes trazables para decidir refuerzo de controles.",
      "delivery": {"mode": "stream", "cadence": "Por intento; alerta en segundos"},
      "privacy": {"containsSensitiveData": true, "handling": "Solo plantilla de ruta y método; nunca URL/ID/IP/user-agent crudos."},
      "allowlist": ["attempted_method", "route_template", "response_status", "detection_source"],
      "properties": {
        "attempted_method": {"type": "string", "enum": ["POST", "PUT", "PATCH", "DELETE"], "required": true, "description": "Método detectado.", "sensitive": false},
        "route_template": {"type": "string", "const": "/inventory/products/{supply_id}/stock", "required": true, "description": "Plantilla fija, no path solicitado.", "sensitive": false},
        "response_status": {"type": "integer", "enum": [403, 404, 405], "required": true, "description": "Rechazo explícito del gateway.", "sensitive": false},
        "detection_source": {"type": "string", "const": "trusted_gateway", "required": true, "description": "Productor confiable.", "sensitive": false}
      }
    },
    {
      "event_type": "inventory_stock_threshold_triggered",
      "classification": "mandatory_briefing",
      "source": "RFI de inventario / badge UI actual",
      "category": "business_inventory",
      "description": "Stock global cruza por primera vez hacia <=10 unidades.",
      "hypothesisDecision": "Necesitamos contar productos que alcanzan el badge bajo para priorizar reposición.",
      "delivery": {"mode": "stream", "cadence": "Solo cruce >10 a <=10; deduplicado"},
      "privacy": {"containsSensitiveData": true, "handling": "IDs operativos; sin información de paciente. Confirmar umbral con Operations."},
      "allowlist": ["supply_id", "current_stock", "threshold", "unit"],
      "properties": {
        "supply_id": {"type": "integer", "required": true, "description": "ID de producto.", "sensitive": true},
        "current_stock": {"type": "integer", "minimum": 0, "required": true, "description": "Stock global calculado.", "sensitive": true},
        "threshold": {"type": "integer", "const": 10, "required": true, "description": "Umbral informativo actual del badge UI.", "sensitive": false},
        "unit": {"type": "string", "enum": ["box", "unit", "pack", "vial"], "required": true, "description": "Unidad de inventario.", "sensitive": false}
      }
    },
    {
      "event_type": "inventory_outbound_insufficient_stock_rejected",
      "classification": "mandatory_briefing",
      "source": "RFI de inventario / validador de dominio",
      "category": "business_inventory",
      "description": "API rechazó una salida que excede stock disponible.",
      "hypothesisDecision": "Necesitamos entender las solicitudes rechazadas para decidir reposición o cambios en el proceso de solicitud.",
      "delivery": {"mode": "stream", "cadence": "Por rechazo; agregado diario"},
      "privacy": {"containsSensitiveData": true, "handling": "No incluye mensaje HTTP completo, usuario real ni datos clínicos."},
      "allowlist": ["supply_id", "available_quantity", "requested_quantity", "clinic_id"],
      "properties": {
        "supply_id": {"type": "integer", "required": true, "description": "ID del producto.", "sensitive": true},
        "available_quantity": {"type": "integer", "minimum": 0, "required": true, "description": "Stock observado por API.", "sensitive": true},
        "requested_quantity": {"type": "integer", "minimum": 1, "required": true, "description": "Cantidad rechazada.", "sensitive": true},
        "clinic_id": {"type": "integer", "minimum": 1, "maximum": 12, "required": true, "description": "Clínica solicitante.", "sensitive": true}
      }
    },
    {
      "event_type": "claim_denial_rate_calculated",
      "classification": "mandatory_briefing",
      "source": "CONTEXT HealthCore / reporte de claims",
      "category": "business_revenue_cycle",
      "description": "Tasa de claims denegados por payer o ubicación.",
      "hypothesisDecision": "Necesitamos comparar la tasa con benchmark 8% para priorizar revisiones de payer/sede.",
      "delivery": {"mode": "batch", "cadence": "Reporte semanal del lunes"},
      "privacy": {"containsSensitiveData": true, "handling": "Solo agregado; no patientId, claimId, claimAmount ni motivo individual."},
      "allowlist": ["group_by", "payerId", "locationId", "periodStart", "periodEnd", "claimsTotal", "claimsDenied", "denialRatePercent", "thresholdPercent"],
      "properties": {
        "group_by": {"type": "string", "enum": ["payerId", "locationId"], "required": true, "description": "Dimensión agregada.", "sensitive": false},
        "payerId": {"type": ["string", "null"], "required": true, "description": "Código payer agregado; null si group_by locationId.", "sensitive": true},
        "locationId": {"type": ["string", "null"], "required": true, "description": "ID de clínica agregado; null si group_by payerId.", "sensitive": true},
        "periodStart": {"type": "string", "format": "date", "required": true, "description": "Inicio de ventana agregada.", "sensitive": false},
        "periodEnd": {"type": "string", "format": "date", "required": true, "description": "Fin de ventana agregada.", "sensitive": false},
        "claimsTotal": {"type": "integer", "minimum": 1, "required": true, "description": "Denominador.", "sensitive": true},
        "claimsDenied": {"type": "integer", "minimum": 0, "required": true, "description": "Numerador.", "sensitive": true},
        "denialRatePercent": {"type": "number", "minimum": 0, "maximum": 100, "required": true, "description": "Porcentaje calculado.", "sensitive": true},
        "thresholdPercent": {"type": "number", "const": 8, "required": true, "description": "Benchmark HealthCore exacto.", "sensitive": false}
      }
    },
    {
      "event_type": "claim_high_denial_rate_flagged",
      "classification": "mandatory_briefing",
      "source": "CONTEXT HealthCore / flagHighDenialPayers",
      "category": "business_revenue_cycle",
      "description": "Tasa agregada de payer supera benchmark.",
      "hypothesisDecision": "Necesitamos identificar payers >8% para decidir orden de revisión de denegaciones.",
      "delivery": {"mode": "batch", "cadence": "Al generar reporte semanal"},
      "privacy": {"containsSensitiveData": true, "handling": "Código payer agregado; suprimir grupos pequeños."},
      "allowlist": ["payerId", "periodStart", "periodEnd", "denialRatePercent", "thresholdPercent", "claimsTotal"],
      "properties": {
        "payerId": {"type": "string", "required": true, "description": "Código de payer; no nombre libre.", "sensitive": true},
        "periodStart": {"type": "string", "format": "date", "required": true, "description": "Inicio de periodo.", "sensitive": false},
        "periodEnd": {"type": "string", "format": "date", "required": true, "description": "Fin de periodo.", "sensitive": false},
        "denialRatePercent": {"type": "number", "minimum": 0, "maximum": 100, "required": true, "description": "Tasa calculada.", "sensitive": true},
        "thresholdPercent": {"type": "number", "const": 8, "required": true, "description": "Benchmark exacto.", "sensitive": false},
        "claimsTotal": {"type": "integer", "minimum": 10, "required": true, "description": "Tamaño mínimo agregado.", "sensitive": true}
      }
    },
    {
      "event_type": "appointment_no_show_cost_calculated",
      "classification": "mandatory_briefing",
      "source": "CONTEXT HealthCore / calculateNoShowCost",
      "category": "business_clinical_operations",
      "description": "Pérdida estimada por no-shows en ventana semanal inclusiva.",
      "hypothesisDecision": "Necesitamos USD perdidos por sede en siete días para priorizar acciones de confirmación y acceso.",
      "delivery": {"mode": "batch", "cadence": "Reporte semanal del lunes"},
      "privacy": {"containsSensitiveData": true, "handling": "Solo total por sede/periodo; no appointmentId, patientId, tarifa individual ni motivo."},
      "allowlist": ["locationId", "periodStart", "periodEnd", "noShowCount", "estimatedLossUsd"],
      "properties": {
        "locationId": {"type": "string", "required": true, "description": "ID de clínica.", "sensitive": true},
        "periodStart": {"type": "string", "format": "date", "required": true, "description": "Primer día de los siete.", "sensitive": false},
        "periodEnd": {"type": "string", "format": "date", "required": true, "description": "Último día inclusive.", "sensitive": false},
        "noShowCount": {"type": "integer", "minimum": 0, "required": true, "description": "Citas agregadas.", "sensitive": true},
        "estimatedLossUsd": {"type": "number", "minimum": 0, "required": true, "description": "Estimación agregada USD redondeada a 2 decimales.", "sensitive": true}
      }
    },
    {
      "event_type": "appointment_no_show_rate_calculated",
      "classification": "mandatory_briefing",
      "source": "CONTEXT HealthCore / noShowRateByLocation",
      "category": "business_clinical_operations",
      "description": "Tasa de no-show por ubicación.",
      "hypothesisDecision": "Necesitamos comparar tasas con 20% para decidir intervención por clínica.",
      "delivery": {"mode": "batch", "cadence": "Reporte semanal"},
      "privacy": {"containsSensitiveData": true, "handling": "Solo agregado por ubicación; no IDs de paciente/cita."},
      "allowlist": ["locationId", "periodStart", "periodEnd", "appointmentsTotal", "noShowCount", "noShowRatePercent", "thresholdPercent"],
      "properties": {
        "locationId": {"type": "string", "required": true, "description": "ID de clínica.", "sensitive": true},
        "periodStart": {"type": "string", "format": "date", "required": true, "description": "Inicio de periodo.", "sensitive": false},
        "periodEnd": {"type": "string", "format": "date", "required": true, "description": "Fin de periodo.", "sensitive": false},
        "appointmentsTotal": {"type": "integer", "minimum": 1, "required": true, "description": "Denominador.", "sensitive": true},
        "noShowCount": {"type": "integer", "minimum": 0, "required": true, "description": "Numerador.", "sensitive": true},
        "noShowRatePercent": {"type": "number", "minimum": 0, "maximum": 100, "required": true, "description": "Porcentaje redondeado a 2 decimales.", "sensitive": true},
        "thresholdPercent": {"type": "number", "const": 20, "required": true, "description": "Umbral interno exacto.", "sensitive": false}
      }
    },
    {
      "event_type": "appointment_high_no_show_rate_flagged",
      "classification": "mandatory_briefing",
      "source": "CONTEXT HealthCore / flagHighNoShowLocations",
      "category": "business_clinical_operations",
      "description": "Ubicación supera el umbral de no-show.",
      "hypothesisDecision": "Necesitamos localizar sedes >20% para decidir revisión operativa.",
      "delivery": {"mode": "batch", "cadence": "Al generar reporte semanal"},
      "privacy": {"containsSensitiveData": true, "handling": "Grupo agregado; suprimir cohortes <10 citas."},
      "allowlist": ["locationId", "periodStart", "periodEnd", "noShowRatePercent", "thresholdPercent", "appointmentsTotal"],
      "properties": {
        "locationId": {"type": "string", "required": true, "description": "ID de clínica.", "sensitive": true},
        "periodStart": {"type": "string", "format": "date", "required": true, "description": "Inicio de periodo.", "sensitive": false},
        "periodEnd": {"type": "string", "format": "date", "required": true, "description": "Fin de periodo.", "sensitive": false},
        "noShowRatePercent": {"type": "number", "minimum": 0, "maximum": 100, "required": true, "description": "Tasa calculada.", "sensitive": true},
        "thresholdPercent": {"type": "number", "const": 20, "required": true, "description": "Umbral interno exacto.", "sensitive": false},
        "appointmentsTotal": {"type": "integer", "minimum": 10, "required": true, "description": "Denominador agregado mínimo.", "sensitive": true}
      }
    },
    {
      "event_type": "clinician_cme_report_generated",
      "classification": "mandatory_briefing",
      "source": "CONTEXT HealthCore / generateCMEReport",
      "category": "business_workforce_compliance",
      "description": "Resumen agregado de cumplimiento CME por rol.",
      "hypothesisDecision": "Necesitamos estado y distribución de horas para decidir seguimiento de CME; Physician requiere 40 y Nurse Practitioner 30 horas/año.",
      "delivery": {"mode": "batch", "cadence": "Reporte semanal del lunes"},
      "privacy": {"containsSensitiveData": true, "handling": "Dato laboral sensible: solo agregado por rol, mínimo 10 personas por cohorte; aprobación RR. HH./Compliance."},
      "allowlist": ["cycleStart", "asOfDate", "clinicianCount", "onTrackCount", "atRiskCount", "overdueCount", "completeCount", "hoursRequiredByRole", "atRiskGapPercentagePoints"],
      "properties": {
        "cycleStart": {"type": "string", "format": "date", "required": true, "description": "Inicio de ciclo reportado.", "sensitive": false},
        "asOfDate": {"type": "string", "format": "date", "required": true, "description": "Fecha de cálculo.", "sensitive": false},
        "clinicianCount": {"type": "integer", "minimum": 10, "required": true, "description": "Total agregado; publicar solo sobre mínimo de cohorte.", "sensitive": true},
        "onTrackCount": {"type": "integer", "minimum": 0, "required": true, "description": "Conteo agregado.", "sensitive": true},
        "atRiskCount": {"type": "integer", "minimum": 0, "required": true, "description": "Conteo agregado.", "sensitive": true},
        "overdueCount": {"type": "integer", "minimum": 0, "required": true, "description": "Conteo agregado.", "sensitive": true},
        "completeCount": {"type": "integer", "minimum": 0, "required": true, "description": "Conteo agregado.", "sensitive": true},
        "hoursRequiredByRole": {"type": "object", "required": true, "additionalProperties": false, "description": "Horas anuales conocidas: physician=40, nurse_practitioner=30; no inferir las demás.", "sensitive": true, "properties": {"physician": {"type": "integer", "const": 40}, "nurse_practitioner": {"type": "integer", "const": 30}}},
        "atRiskGapPercentagePoints": {"type": "number", "const": 15, "required": true, "description": "Rezago HealthCore exacto.", "sensitive": false}
      }
    },
    {
      "event_type": "clinician_cme_at_risk_detected",
      "classification": "mandatory_briefing",
      "source": "CONTEXT HealthCore / getCliniciansAtRisk",
      "category": "business_workforce_compliance",
      "description": "Conteo agregado de clínicos en riesgo o overdue.",
      "hypothesisDecision": "Necesitamos cuantificar cumplimiento atrasado frente a rezago 15 pp para decidir seguimiento preventivo.",
      "delivery": {"mode": "batch", "cadence": "Reporte semanal; sin alerta individual analítica"},
      "privacy": {"containsSensitiveData": true, "handling": "Solo conteo agregado de cohorte >=10; no clinicianId/nombre/horas individuales."},
      "allowlist": ["asOfDate", "atRiskCount", "overdueCount", "atRiskGapPercentagePoints"],
      "properties": {
        "asOfDate": {"type": "string", "format": "date", "required": true, "description": "Fecha de cálculo.", "sensitive": false},
        "atRiskCount": {"type": "integer", "minimum": 0, "required": true, "description": "Conteo agregado en riesgo.", "sensitive": true},
        "overdueCount": {"type": "integer", "minimum": 0, "required": true, "description": "Conteo agregado vencido.", "sensitive": true},
        "atRiskGapPercentagePoints": {"type": "number", "const": 15, "required": true, "description": "Umbral exacto del ciclo.", "sensitive": false}
      }
    },
    {
      "event_type": "clinician_license_alert_triggered",
      "classification": "mandatory_briefing",
      "source": "CONTEXT HealthCore / getCliniciansWithExpiringLicences",
      "category": "business_workforce_compliance",
      "description": "Conteo de alertas de licencia por ventana configurada.",
      "hypothesisDecision": "Necesitamos saber vencimientos en 90 días y urgentes en 30 para priorizar renovación de credenciales.",
      "delivery": {"mode": "stream", "cadence": "Evaluación diaria; primera alerta a 90 y urgente a 30 días"},
      "privacy": {"containsSensitiveData": true, "handling": "Dato laboral regulatorio: solo conteo agregado de cohorte >=10; alerta individual queda en sistema RR. HH. autorizado."},
      "allowlist": ["asOfDate", "windowDays", "alertLevel", "clinicianCount"],
      "properties": {
        "asOfDate": {"type": "string", "format": "date", "required": true, "description": "Fecha de evaluación.", "sensitive": false},
        "windowDays": {"type": "integer", "enum": [90, 30], "required": true, "description": "Umbral exacto de primera o urgente advertencia.", "sensitive": false},
        "alertLevel": {"type": "string", "enum": ["warning", "urgent"], "required": true, "description": "90=warning; 30=urgent.", "sensitive": false},
        "clinicianCount": {"type": "integer", "minimum": 10, "required": true, "description": "Conteo agregado; solo publicar cohorte suficiente.", "sensitive": true}
      }
    },
    {
      "event_type": "auth_login_succeeded",
      "classification": "proposed_opportunity",
      "source": "POST /login",
      "category": "authentication",
      "description": "Inicio de sesión completado.",
      "hypothesisDecision": "Necesitamos adopción agregada por rol para dimensionar soporte y capacidad.",
      "delivery": {"mode": "batch", "cadence": "Agregación diaria"},
      "privacy": {"containsSensitiveData": true, "handling": "userId HMAC; no username, email, token o IP; agregar y eliminar detalle según retención."},
      "allowlist": ["role"],
      "properties": {"role": {"type": "string", "enum": ["admin", "manager", "user"], "required": true, "description": "Rol vigente, no identidad.", "sensitive": true}}
    },
    {
      "event_type": "auth_login_failed",
      "classification": "proposed_opportunity",
      "source": "POST /login 401",
      "category": "authentication_security",
      "description": "Autenticación rechazada de forma genérica.",
      "hypothesisDecision": "Necesitamos tendencia de fallos para decidir mejoras de UX o mitigación de abuso.",
      "delivery": {"mode": "stream", "cadence": "Alertar por tasa agregada; detalle solo códigos"},
      "privacy": {"containsSensitiveData": true, "handling": "No incluir username/email/IP/contraseña; evento agregado y neutral."},
      "allowlist": ["failure_reason"],
      "properties": {"failure_reason": {"type": "string", "enum": ["invalid_credentials", "rate_limited", "service_unavailable"], "required": true, "description": "Código no identificable.", "sensitive": false}}
    },
    {
      "event_type": "auth_session_rejected",
      "classification": "proposed_opportunity",
      "source": "Dependencia de bearer /me y rutas protegidas",
      "category": "authentication",
      "description": "Token inválido, expirado o revocado.",
      "hypothesisDecision": "Necesitamos separar fallos de sesión para decidir cambios de duración o diagnóstico de revocación.",
      "delivery": {"mode": "batch", "cadence": "Agregado diario; alerta por aumento"},
      "privacy": {"containsSensitiveData": true, "handling": "Nunca registrar token, claims, cookie o ID de usuario crudo."},
