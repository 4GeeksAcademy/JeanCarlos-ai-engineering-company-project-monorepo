# RAG knowledge base (Hito 7). Copy the lines you need into services/api/.env (gitignored).
# Gateway of 4Geeks (OpenAI-compatible). The key is personal: never commit it.
LLM_API_URL=https://llm.4geeks.ai
LLM_API_KEY=
# Two different models (data/process/rag.py refuses to start if they are the same).
# IDs as listed by GET {LLM_API_URL}/v1/models, without any "litellm/" prefix.
EMBEDDING_MODEL=madrid-spain/openrouter/perplexity/pplx-embed-v1-0.6b
GENERATION_MODEL=madrid-spain/openrouter/deepseek/deepseek-v4-flash
# Qdrant: localhost from the host; docker-compose sets http://qdrant:6333 for the api service.
QDRANT_URL=http://localhost:6333
# Optional: QDRANT_API_KEY (Qdrant Cloud) and RAG_MIN_SCORE (default 0.30).

# ---- Security (OWASP Top 10 audit, docs/security/owasp-top10-audit.md)
# RFP sign-off (A01): backoffice accounts allowed to decide for each department (BRIEFING §2.1).
# Unset = nobody can approve (fail closed). Usernames, lowercase.
RFP_APPROVERS={"revenue": ["tom.callahan"], "clinical": ["marcus.reid"], "compliance": ["claire.whitfield"]}
# Brute-force protection of /login (A07): failures per username within the window → 429.
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=900
# Swagger / ReDoc / OpenAPI (A05): off by default; set to 1 only for local development.
API_DOCS_ENABLED=0
# Remote PostgreSQL URLs without sslmode get sslmode=require automatically (A02).
# Rate limits of the model-backed endpoints (NIST Protect, services/api/core/rate_limit.py).
# Per scope: knowledge (RAG), agent (Compliance assistant REST + WebSocket), rfp (upload / generate / request_changes).
# MODEL_RATE_KNOWLEDGE_PER_USER=10  MODEL_RATE_KNOWLEDGE_WINDOW_SECONDS=60  MODEL_RATE_KNOWLEDGE_GLOBAL_PER_MINUTE=60
# MODEL_RATE_AGENT_PER_USER=10      MODEL_RATE_AGENT_WINDOW_SECONDS=60      MODEL_RATE_AGENT_GLOBAL_PER_MINUTE=60
# MODEL_RATE_RFP_PER_USER=5         MODEL_RATE_RFP_WINDOW_SECONDS=600       MODEL_RATE_RFP_GLOBAL_PER_MINUTE=20
