# Optional overrides for `docker compose up`. Copy to .env (ignored by git).
# Nothing here is required: compose.dev.env provides development defaults.

# Signing key for access tokens (>= 32 bytes). If unset, the API generates one on
# first start and stores it in the api_data volume.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=

# Inventory database. Defaults to the bundled `db` service; set it to use an
# external PostgreSQL such as Supabase (add ?sslmode=require).
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# If you change the bundled database password, update DATABASE_URL too.
# POSTGRES_PASSWORD=

# Password recovery emails (optional; without them recovery stays disabled).
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# FRONTEND_BASE_URL=http://localhost:3001
