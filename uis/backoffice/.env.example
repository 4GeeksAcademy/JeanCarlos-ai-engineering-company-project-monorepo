SUPPLIERS_API_URL=http://127.0.0.1:8000
# Browser-side telemetry target: same-origin proxy (avoids CORS, keeps the token server-side).
NEXT_PUBLIC_TELEMETRY_ENDPOINT=/api/telemetry/events
# Where the proxy forwards batches. Today the FastAPI stub; in Phase 3 the real
# endpoint with persistence. Changing it requires no frontend code changes.
TELEMETRY_ENDPOINT=http://127.0.0.1:8000/telemetry/events
