# Copy to .env.local (ignored by git) and adjust. Never commit tokens or real URLs.
# Base URL of the HealthCore API (suppliers, auth, telemetry).
SUPPLIERS_API_URL=http://127.0.0.1:8000
# Base URL of the inventory API (/inventory/*). Optional: defaults to SUPPLIERS_API_URL.
# Read only by the Next.js server proxy; requests carry Authorization: Bearer <token>.
# Prefer 127.0.0.1: "localhost" may resolve to IPv6 (::1) and reach another local server.
NEXT_PUBLIC_INVENTORY_API_URL=http://127.0.0.1:8000
