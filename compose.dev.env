# Development defaults for `docker compose up` (versioned on purpose: no secrets).
# Override any value in an untracked .env (see .env.example).
# JWT_SECRET_KEY is intentionally absent: the API entrypoint generates one per
# installation and keeps it in the api_data volume.
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_EXPIRE_MINUTES=30
FRONTEND_BASE_URL=http://localhost:3001
# Bundled PostgreSQL service (db). Must match POSTGRES_PASSWORD if you change it.
DATABASE_URL=postgresql://healthcore:healthcore-dev@db:5432/healthcore
